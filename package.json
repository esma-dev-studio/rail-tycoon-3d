{
  "name": "rail-tycoon-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "町をつなぎ、電車と町を育て続ける小学生向け3D鉄道ゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:network": "node --experimental-strip-types scripts/verify-network.ts",
    "verify:growth": "node --experimental-strip-types scripts/verify-growth.ts",
    "verify:adventure": "node scripts/verify-adventure.mjs",
    "verify:browser": "node scripts/verify-ipad.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.109.2",
    "@react-three/fiber": "8.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.161.0",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.161.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.4.5",
    "vite": "5.4.2"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.21.0"
  }
}
